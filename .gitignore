.venv/
__pycache__/
*.pyc
.pytest_cache/
.env

# Internal sha256 response cache (results/cache/<hash>.json, one file per
# API call made during collection): a performance optimization only, used
# solely to avoid re-billing an already-answered prompt during live
# collection runs. Every field it holds is already present in the
# corresponding results/raw/*.jsonl line. Not needed for -- and not read
# by -- reproduce_paper.py or any analysis script. Excluded to avoid
# committing ~23,000 small files that duplicate raw/ with no reproducibility
# value; see REPRODUCIBILITY.md.
results/cache/

*.parquet
.DS_Store

# LaTeX build artifacts (regenerated by pdflatex; main.pdf itself is
# tracked as the compiled paper).
paper/latex-src/main.aux
paper/latex-src/main.log
paper/latex-src/main.out
paper/latex-src/main.synctex.gz

# results/raw/*.jsonl (the frozen model outputs the paper's results are
# computed from) and results/processed/*.json (their frozen analysis
# outputs) are intentionally tracked, not ignored -- see REPRODUCIBILITY.md.

# Journal-submission working materials: kept locally, never in the public repo.
/paper/jair-submission/
/paper/jaamas-submission/
/paper/JAAMAS_INFORMATION_SHEET.md
/JAAMAS_PREPARATION_AUDIT.md
/JAIR_MIGRATION_NOTES.md
/JAIR_SUBMISSION_QUESTIONS.md
/PRECEDENCE_INTEGRATION_NOTES.md
/REFRAMING_NOTES.md
/RESTRUCTURE_NOTES.md
/JAIR AuthorKit-OTH.zip
/paper/arxiv-submission.zip
